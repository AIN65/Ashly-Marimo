{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered player in the Star Strick system.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "gamertag": { "type": "string" },
        "email": { "type": "string" },
        "realName": { "type": "string" },
        "clubName": { "type": "string" },
        "position": { "type": "string" },
        "region": { "type": "string" },
        "globalPoints": { "type": "number" },
        "winRate": { "type": "number" },
        "matchesPlayed": { "type": "number" },
        "seed": { "type": "string" },
        "form": { "type": "array", "items": { "type": "string" } },
        "joinDate": { "type": "number", "description": "Timestamp" }
      },
      "required": ["userId", "gamertag", "email", "joinDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    }
  }
}
