rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isValidUser(data, authUid) {
      return data.keys().hasAll(['userId', 'gamertag', 'email', 'joinDate', 'globalPoints', 'winRate', 'matchesPlayed', 'seed', 'form']) &&
             data.userId == authUid &&
             data.gamertag is string && data.gamertag.size() > 0 && data.gamertag.size() <= 64 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.joinDate is number &&
             data.globalPoints is int &&
             data.winRate is number &&
             data.matchesPlayed is int &&
             data.seed is string && data.seed.size() <= 64 &&
             data.form is list && data.form.size() <= 10 &&
             (!('realName' in data.keys()) || data.realName == null || (data.realName is string && data.realName.size() <= 64)) &&
             (!('clubName' in data.keys()) || data.clubName == null || (data.clubName is string && data.clubName.size() <= 64)) &&
             (!('position' in data.keys()) || data.position == null || (data.position is string && data.position.size() <= 32)) &&
             (!('region' in data.keys()) || data.region == null || (data.region is string && data.region.size() <= 64));
    }
    
    match /users/{userId} {
      allow get, list: if isSignedIn(); // Allow registered users to see others
      
      allow create: if isSignedIn() &&
                    isValidId(userId) &&
                    userId == request.auth.uid &&
                    isValidUser(incoming(), request.auth.uid);
                    
      allow update: if isSignedIn() &&
                    isValidId(userId) &&
                    userId == request.auth.uid &&
                    isValidUser(incoming(), request.auth.uid) &&
                    incoming().userId == existing().userId &&
                    incoming().joinDate == existing().joinDate &&
                    incoming().email == existing().email &&
                    incoming().gamertag == existing().gamertag &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['realName', 'clubName', 'position', 'region']);
    }
  }
}
